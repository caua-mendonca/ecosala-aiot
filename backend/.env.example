# Copie este arquivo para ".env" e preencha com os valores locais.
# Nunca versione o arquivo ".env" real (ja esta no .gitignore).

# --- MQTT (Mosquitto local, ver infra/mosquitto/) ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=backend
MQTT_PASSWORD=changeme

# Usadas apenas pelo teste de integracao tests/integration/test_mqtt_subscriber_integration.py
# (simula um dispositivo publicando telemetria)
MQTT_DEVICE_USERNAME=device
MQTT_DEVICE_PASSWORD=changeme

# --- InfluxDB (ver infra/influxdb/setup.md) ---
INFLUXDB_URL=http://localhost:8086
INFLUXDB_ORG=ecosala-org
INFLUXDB_BUCKET=ecosala
INFLUXDB_TOKEN=changeme

# --- Faixas de conforto (configuraveis, ver docs/problema.md) ---
COMFORT_TEMPERATURE_MIN_C=20.0
COMFORT_TEMPERATURE_MAX_C=26.0
COMFORT_HUMIDITY_MIN_PERCENT=40.0
COMFORT_HUMIDITY_MAX_PERCENT=60.0
COMFORT_LUMINOSITY_MIN_LUX=300.0
COMFORT_TEMPERATURE_CRITICAL_MARGIN_C=4.0
COMFORT_HUMIDITY_CRITICAL_MARGIN_PERCENT=15.0
COMFORT_LUMINOSITY_CRITICAL_MARGIN_LUX=150.0

# --- API ---
CORS_ALLOWED_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
